    "test_scenarios": {
        "scenario_1_basic_workflow": {
            "title": "Flujo Básico: Crear → Leer → Actualizar",
            "steps": [
                {
                    "step": 1,
                    "name": "Crear reporte con fotos",
                    "method": "POST",
                    "endpoint": "/damage-reports",
                    "body": {
                        "vehicle_id": "vehicle-456",
                        "description": "Daño por colisión",
                        "damage_location": "Bumper frontal",
                        "severity": "moderate",
                        "status": "pending",
                        "estimated_cost": 1500.50,
                        "reported_by": "Juan Pérez"
                    },
                    "expected_status": 201
                },
                {
                    "step": 2,
                    "name": "Guardar el ID del reporte",
                    "note": "El ID se retorna en la respuesta, guardarlo en {{reportId}}"
                },
                {
                    "step": 3,
                    "name": "Obtener el reporte creado",
                    "method": "GET",
                    "endpoint": "/damage-reports/{{reportId}}",
                    "expected_status": 200
                },
                {
                    "step": 4,
                    "name": "Actualizar estado a in_review",
                    "method": "PATCH",
                    "endpoint": "/damage-reports/{{reportId}}",
                    "body": {
                        "status": "in_review",
                        "estimated_cost": 2000.00
                    },
                    "expected_status": 200
                }
            ]
        },
        "scenario_2_photo_management": {
            "title": "Gestión de Fotos: Crear con fotos → Agregar más fotos",
            "steps": [
                {
                    "step": 1,
                    "name": "Crear reporte con 2 fotos iniciales",
                    "method": "POST",
                    "endpoint": "/damage-reports",
                    "body": "form-data con vehicle_id y 2 archivos en 'photos'",
                    "expected_status": 201,
                    "note": "La respuesta debe contener 2 URLs en el array photos"
                },
                {
                    "step": 2,
                    "name": "Agregar 3 fotos adicionales",
                    "method": "PATCH",
                    "endpoint": "/damage-reports/{{reportId}}/photos",
                    "body": "form-data con 3 archivos en 'photos'",
                    "expected_status": 200,
                    "note": "El array photos debe contener ahora 5 URLs (2 + 3)"
                },
                {
                    "step": 3,
                    "name": "Verificar que todas las fotos están presentes",
                    "method": "GET",
                    "endpoint": "/damage-reports/{{reportId}}",
                    "expected_status": 200,
                    "validation": "photos.length === 5"
                }
            ]
        },
        "scenario_3_status_workflow": {
            "title": "Ciclo de Estados: pending → in_review → approved → completed",
            "steps": [
                {
                    "step": 1,
                    "name": "Crear reporte (estado: pending)",
                    "method": "POST",
                    "endpoint": "/damage-reports"
                },
                {
                    "step": 2,
                    "name": "Cambiar a in_review",
                    "method": "PATCH",
                    "endpoint": "/damage-reports/{{reportId}}",
                    "body": {
                        "status": "in_review"
                    }
                },
                {
                    "step": 3,
                    "name": "Cambiar a approved",
                    "method": "PATCH",
                    "endpoint": "/damage-reports/{{reportId}}",
                    "body": {
                        "status": "approved"
                    }
                },
                {
                    "step": 4,
                    "name": "Cambiar a completed",
                    "method": "PATCH",
                    "endpoint": "/damage-reports/{{reportId}}",
                    "body": {
                        "status": "completed"
                    }
                }
            ]
        },
        "scenario_4_severity_levels": {
            "title": "Probar todos los niveles de severidad",
            "steps": [
                {
                    "step": 1,
                    "name": "Crear reporte severity: minor",
                    "method": "POST",
                    "endpoint": "/damage-reports",
                    "body": {
                        "severity": "minor",
                        "estimated_cost": 250
                    }
                },
                {
                    "step": 2,
                    "name": "Crear reporte severity: moderate",
                    "method": "POST",
                    "endpoint": "/damage-reports",
                    "body": {
                        "severity": "moderate",
                        "estimated_cost": 1500
                    }
                },
                {
                    "step": 3,
                    "name": "Crear reporte severity: severe",
                    "method": "POST",
                    "endpoint": "/damage-reports",
                    "body": {
                        "severity": "severe",
                        "estimated_cost": 8500
                    }
                },
                {
                    "step": 4,
                    "name": "Crear reporte severity: total_loss",
                    "method": "POST",
                    "endpoint": "/damage-reports",
                    "body": {
                        "severity": "total_loss",
                        "estimated_cost": 25000
                    }
                }
            ]
        },
        "scenario_5_filtering": {
            "title": "Filtrar reportes por vehículo",
            "steps": [
                {
                    "step": 1,
                    "name": "Crear 3 reportes para el mismo vehículo",
                    "method": "POST",
                    "endpoint": "/damage-reports",
                    "count": 3
                },
                {
                    "step": 2,
                    "name": "Obtener todos los reportes del tenant",
                    "method": "GET",
                    "endpoint": "/damage-reports",
                    "validation": "response.length >= 3"
                },
                {
                    "step": 3,
                    "name": "Filtrar solo por vehículo específico",
                    "method": "GET",
                    "endpoint": "/damage-reports/vehicle/{{vehicleId}}",
                    "validation": "response.length === 3 && response[0].vehicle_id === {{vehicleId}}"
                }
            ]
        },
        "scenario_6_error_handling": {
            "title": "Pruebas de manejo de errores",
            "steps": [
                {
                    "step": 1,
                    "name": "Crear sin vehicle_id",
                    "method": "POST",
                    "endpoint": "/damage-reports",
                    "body": {
                        "description": "Sin vehicle_id"
                    },
                    "expected_status": 400,
                    "expected_error": "vehicle_id is required"
                },
                {
                    "step": 2,
                    "name": "Obtener reporte inexistente",
                    "method": "GET",
                    "endpoint": "/damage-reports/id-inexistente",
                    "expected_status": 404,
                    "expected_error": "Damage report not found"
                },
                {
                    "step": 3,
                    "name": "Agregar fotos sin archivos",
                    "method": "PATCH",
                    "endpoint": "/damage-reports/{{reportId}}/photos",
                    "body": {},
                    "expected_status": 400,
                    "expected_error": "No photos provided"
                },
                {
                    "step": 4,
                    "name": "Sin token JWT",
                    "method": "GET",
                    "endpoint": "/damage-reports",
                    "headers": "Sin Authorization",
                    "expected_status": 401
                }
            ]
        }
    },
